.bottom-space { height: 60rpx; }

/* ---------- 结果主卡 ---------- */
/* 主卡文案为白字，必须配深色底；否则会被全局 .card 的白底覆盖而“显示为空白” */
.card.hero {
  background: linear-gradient(150deg, #323232 0%, #232323 55%, #1C1C1C 100%);
  color: #FFFFFF;
}

.hero-label {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-num {
  margin-top: 12rpx;
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-tags {
  display: flex;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.htag {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.htag-v {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.htag-l {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.66);
}

/* ---------- 参数滑块 ---------- */
.sl-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sl-row:last-child { border-bottom: none; }

.sl-name {
  font-size: 26rpx;
  color: var(--t2);
}

.sl-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.quick {
  display: flex;
  margin-top: 6rpx;
}

.quick-btn {
  padding: 8rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #EFF2F1;
  font-size: 22rpx;
  color: var(--t2);
}

.quick-btn.on {
  background: rgba(31, 157, 107, 0.12);
  color: var(--primary);
  font-weight: 600;
}

.param-note {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #F7F9F8;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--t2);
}

/* ---------- 增长曲线 ---------- */
.curve {
  display: flex;
  align-items: flex-end;
}

.curve-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.curve-val {
  margin-bottom: 10rpx;
  font-size: 18rpx;
  color: var(--t3);
}

/* 统一的柱高基准，柱子按百分比在其中生长 */
.curve-bar-wrap {
  height: 170rpx;
  display: flex;
  align-items: flex-end;
}

.curve-bar {
  width: 26rpx;
  /* 高度由内联的 --h 提供（0~100%） */
  height: var(--h, 0%);
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, #35C48C, #1F9D6B);
}

.curve-label {
  margin-top: 12rpx;
  font-size: 18rpx;
  color: var(--t3);
}

.curve-note {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--t3);
}

/* ---------- 息率对比 ---------- */
.cmp-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.cmp-row:last-child { border-bottom: none; }
.cmp-row:active { background: #FAFBFB; }

.cmp-no {
  width: 46rpx;
  height: 46rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #EFF2F1;
  color: var(--t2);
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
  line-height: 46rpx;
  flex-shrink: 0;
}

.cmp-no.top {
  background: var(--primary);
  color: #fff;
}

.cmp-body { min-width: 0; }

.bar {
  margin-top: 14rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #EFF2F1;
  overflow: hidden;
}

.bar-in {
  /* 宽度由内联的 --w 提供（0~100%） */
  width: var(--w, 0%);
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2FB57E, #1F9D6B);
}

.cmp-val {
  margin-left: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--t1);
  flex-shrink: 0;
}

/* ---------- 定投标的池 ---------- */
.pool {
  display: flex;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.pool-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 26rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  flex-shrink: 0;
}

.pool-item.on {
  border-color: var(--primary);
  background: rgba(31, 157, 107, 0.08);
}

.pool-name {
  font-size: 25rpx;
  color: var(--t1);
}

.pool-item.on .pool-name {
  color: var(--primary);
  font-weight: 600;
}

.pool-yield {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--t3);
}

.pool-item.on .pool-yield { color: var(--primary); }

/* ---------- 逐年明细表 ---------- */
.dca-head {
  display: flex;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 21rpx;
  color: var(--t3);
}

.dca-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--t1);
}

.dca-row:last-child { border-bottom: none; }

/* 四列定宽，数字列右对齐并等宽，便于纵向比对 */
.dca-c1 { width: 110rpx; flex-shrink: 0; }
.dca-c2 { flex: 1; text-align: right; }
.dca-c3 { flex: 1.1; text-align: right; font-weight: 600; }
.dca-c4 { flex: 1; text-align: right; }

.foot-tip {
  padding: 30rpx 8rpx 0;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--t3);
}

/* 与其他页面保持一致：浅灰绿底 + 白色卡片 */
page {
  background-color: #F5F7F6;
}

.page { padding-bottom: 260rpx; }

/* ---------- 顶部提示 ---------- */
.tip {
  background: var(--warm-bg);
  border: 1rpx solid var(--warm-line);
  border-radius: 18rpx;
  padding: 24rpx;
  font-size: 25rpx;
  color: var(--warm-text);
  line-height: 1.6;
}

/* 注意：这里不能用 margin 简写，否则会把 app.wxss 里 .mt32 的 margin-top 覆盖成 0 */
.sec-head {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  margin: 40rpx 0 20rpx;
}

.reset {
  font-size: 25rpx;
  color: var(--t3);
  padding: 6rpx 8rpx;
}

/* ---------- 实时预览 ---------- */
.preview {
  background: linear-gradient(150deg, #323232 0%, #232323 55%, #1C1C1C 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  color: #FFFFFF;
}

.preview-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.preview-num {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}

/* 橙色描边 + 提亮底色：与 banner 本身形成"可变动区域"与"固定 banner"的区分 */
.preview-box {
  margin-top: 26rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid var(--orange);
  border-radius: 18rpx;
  padding: 18rpx 6rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
}

.metric {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  padding: 10rpx 12rpx;
}

.metric-name {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.6);
}

.metric-value {
  font-size: 26rpx;
  margin-top: 8rpx;
  color: #FFFFFF;
}

.preview-empty {
  padding: 44rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.preview-cap {
  margin-top: 18rpx;
  text-align: center;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* ---------- 指标行 ---------- */
.mrow {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.mrow:last-child { border-bottom: none; }
.mrow:active { background: #FAFBFB; }

.idx {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #EFF2F1;
  color: var(--t3);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.idx.on {
  background: #232323;
  color: #FFFFFF;
  font-weight: 600;
}

.val {
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  margin-left: 12rpx;
}

.val.up { color: var(--up); }

.none {
  padding: 56rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--t3);
}

/* ---------- 底部保存 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 55;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--line);
}

.save-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #232323;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.save-btn.off { background: #C9CFCC; }

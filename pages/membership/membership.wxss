.page {
  padding: 20rpx 24rpx 0;
  padding-bottom: 200rpx;
}

/* ---------- 兜底错误态 ---------- */
.err {
  margin-top: 40rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.err-emoji {
  font-size: 60rpx;
}

.err-btn {
  width: 240rpx;
  margin: 32rpx auto 0;
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: #232323;
  color: #FFFFFF;
  font-size: 28rpx;
}

/* ---------- 当前档位 ---------- */
.status {
  background: #232323;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  color: #FFFFFF;
}

.crown {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.status-name {
  font-size: 32rpx;
  font-weight: 600;
}

.status-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(240, 154, 60, 0.2);
  color: #F5A94B;
  font-size: 23rpx;
}

.status-free {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* ---------- 免费开放期 ---------- */
/* 绿色调，和「已解锁 / 免费」的语义一致，避免被误读成促销 */
.free-open {
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid rgba(47, 181, 126, 0.28);
  background: rgba(47, 181, 126, 0.08);
  border-radius: 20rpx;
}

.free-emoji {
  font-size: 44rpx;
  flex-shrink: 0;
}

.free-price {
  color: #1F9D6B;
}

/* ---------- 权益对比表 ---------- */
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}

.sec-title.center {
  text-align: center;
  padding-bottom: 8rpx;
}

.t-head,
.t-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
}

.t-head {
  border-bottom: 1rpx solid var(--line);
}

.t-head .c-name,
.t-head .c-val {
  font-size: 24rpx;
  color: var(--t3);
}

.t-row {
  border-bottom: 1rpx solid var(--line-2);
}

.t-row:last-of-type {
  border-bottom: 0;
}

.c-name {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--t1);
}

.c-val {
  width: 104rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--t2);
}

.c-val.off {
  color: var(--t3);
}

/* Pro 列整列强调：表头橙字，单元格浅橙底 */
.t-head .pro-col {
  color: var(--orange);
  font-weight: 600;
}

.c-val.pro-col {
  width: 116rpx;
}

.c-val.pro-col.on {
  color: var(--orange);
  font-weight: 600;
  background: rgba(240, 154, 60, 0.1);
  border-radius: 10rpx;
  padding: 8rpx 0;
}

.t-row .c-val:last-child {
  margin-right: -8rpx;
}

/* 还没上线的功能如实标注 */
.soon {
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: var(--line-2);
  color: var(--t3);
  font-size: 19rpx;
  flex-shrink: 0;
}

.table-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--t3);
  line-height: 1.5;
}

/* ---------- 方案 ---------- */
.plan {
  position: relative;
  margin-top: 20rpx;
  padding: 26rpx 26rpx 22rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.plan.on {
  border-color: var(--orange);
  box-shadow: 0 8rpx 24rpx rgba(240, 154, 60, 0.16);
}

.plan-badge {
  position: absolute;
  right: -2rpx;
  top: -2rpx;
  padding: 8rpx 18rpx;
  border-radius: 0 20rpx 0 20rpx;
  background: var(--orange);
  color: #FFFFFF;
  font-size: 21rpx;
}

.plan-badge.best {
  background: #2FB57E;
}

.plan-head {
  display: flex;
  align-items: flex-start;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}

.plan-own {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(47, 181, 126, 0.12);
  color: #1F9D6B;
  font-size: 20rpx;
}

.plan-price {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.plan-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #232323;
  font-variant-numeric: tabular-nums;
}

.plan-unit {
  font-size: 24rpx;
  color: var(--t3);
}

.plan-strike {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--t3);
  text-decoration: line-through;
}

.plan-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--t2);
}

.plan-tip {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(240, 154, 60, 0.1);
  font-size: 22rpx;
  color: #C97C25;
  line-height: 1.5;
}

/* ---------- 说明 / 兑换码 ---------- */
.notes {
  margin-top: 30rpx;
}

.note-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 23rpx;
  color: var(--t3);
}

.tick {
  margin-right: 10rpx;
  color: #2FB57E;
}

.redeem {
  margin-top: 26rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--orange);
}

.bottom-space {
  height: 40rpx;
}

/* ---------- 底部购买栏 ---------- */
.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--line);
}

.buy-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.buy-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--orange);
  font-variant-numeric: tabular-nums;
}

.buy-unit {
  font-size: 24rpx;
  font-weight: 400;
}

.buy-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--t3);
}

.buy-btn {
  flex-shrink: 0;
  padding: 24rpx 56rpx;
  border-radius: 999rpx;
  background: #232323;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
}

.buy-btn.off {
  opacity: 0.6;
}

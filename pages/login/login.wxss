.login {
  min-height: 100vh;
  background: #FFFFFF;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.glow {
  position: absolute;
  top: -180rpx;
  left: 50%;
  width: 780rpx;
  height: 780rpx;
  margin-left: -390rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(31, 157, 107, 0.16) 0%, rgba(31, 157, 107, 0) 68%);
}

.brand {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 180rpx;
  position: relative;
}

.logo {
  font-size: 150rpx;
  line-height: 1;
}

.app-name {
  margin-top: 36rpx;
  font-size: 62rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  color: var(--t1);
}

.slogan {
  margin-top: 20rpx;
  font-size: 27rpx;
  color: var(--t3);
  letter-spacing: 1rpx;
}

.bottom {
  padding: 0 56rpx 40rpx;
  position: relative;
}

.guide-entry {
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  padding: 0 0 32rpx;
}

/* ---------- 手机号快捷登录按钮 ---------- */
.main-wrap {
  position: relative;
}

.main-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
  margin: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1F1F1F;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 去掉小程序 button 默认的伪元素边框 */
.main-btn::after {
  border: none;
  display: none;
}

.main-btn[disabled] {
  background: #C9CFCC;
  color: #FFFFFF;
  opacity: 1;
}

/* 未同意协议时的点击拦截层 */
.main-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 999rpx;
  z-index: 2;
}

.agree {
  margin-top: 52rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #D3D8D6;
  margin-right: 12rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.tick {
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
}

.agree-text {
  font-size: 23rpx;
  color: var(--t3);
  line-height: 1.5;
}

.link {
  color: var(--primary);
}

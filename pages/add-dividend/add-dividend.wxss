.page { padding: 24rpx 32rpx 60rpx; }

.title {
  padding: 8rpx 0 28rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--t1);
}

/* ---------- 股票信息 ---------- */
.stock-card {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #EFEFEE;
}

.stock-label {
  font-size: 22rpx;
  color: var(--t3);
}

.stock-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.stock-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--t1);
}

/* ---------- 字段 ---------- */
/* 本页字段直接长在背景上：不套白卡，只用一条下划线分隔 */
.label {
  padding: 36rpx 0 6rpx;
  font-size: 27rpx;
  color: var(--t1);
}

.req { color: var(--up); margin-right: 4rpx; }

.u-field {
  height: 78rpx;
  border-bottom: 1rpx solid #E3E7E5;
  font-size: 30rpx;
  color: var(--t1);
}

.u-row {
  display: flex;
  align-items: center;
}

.unit {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--t3);
  flex-shrink: 0;
}

.hint {
  padding-top: 14rpx;
  font-size: 22rpx;
  color: var(--t3);
}

.ph { color: #C4C9CE; }

/* ---------- 红利税（选填） ---------- */
.tax-box {
  margin-top: 32rpx;
  padding: 22rpx 24rpx 18rpx;
  border-radius: 16rpx;
  background: var(--warm-bg);
}

.tax-head {
  display: flex;
  align-items: center;
}

.tax-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--orange);
}

.q {
  width: 32rpx;
  height: 32rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(224, 137, 44, 0.5);
  color: var(--orange);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 暖色底上的下划线也要跟着变淡，否则会割裂整块色 */
.tax-box .u-field {
  height: 72rpx;
  border-bottom-color: rgba(224, 137, 44, 0.28);
}

.tax-tip {
  padding-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #B08A55;
}

/* ---------- 确认 ---------- */
.bottom-space { height: 56rpx; }

.confirm {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #232323;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.confirm:active { opacity: 0.88; }
.confirm.off { opacity: 0.6; }

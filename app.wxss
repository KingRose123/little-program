page {
  --primary: #1F9D6B;
  --primary-light: #2FB57E;
  --primary-soft: #EAF6F1;
  --gold: #D9A93C;
  --gold-light: #E8B44A;
  --orange: #E0892C;
  --orange-light: #F0A24A;
  --dark-card: #2A2A2A;
  --dark-card-2: #202020;
  --bg: #F5F7F6;
  --card: #FFFFFF;
  --t1: #1A1A1A;
  --t2: #6B7280;
  --t3: #9CA3AF;
  --t4: #C4C9CE;
  --line: #EEF1F0;
  --line-2: #F2F4F3;
  --up: #E5484D;
  --blue: #3B82C4;
  --warm-bg: #FDF4E4;
  --warm-line: #F2E1BF;
  --warm-text: #8A6A22;
  /* 用 background-color 而非 background 简写：避免个别基础库版本下
     var() 在 page 节点的简写属性里不生效，导致部分页面底色偏白 */
  background-color: var(--bg);
  color: var(--t1);
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, button, input, textarea, image {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.page-flat {
  padding: 0 24rpx 60rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(23, 43, 35, 0.05);
}

.card-flat {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(23, 43, 35, 0.05);
  overflow: hidden;
  padding: 8rpx 28rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  margin: 36rpx 0 20rpx;
  padding: 0 8rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex1 { flex: 1; min-width: 0; }

.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; }
.mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; }
.ml8 { margin-left: 8rpx; }
.ml12 { margin-left: 12rpx; }
.ml16 { margin-left: 16rpx; }

/* ---------- 文字 ---------- */
.muted { color: var(--t2); }
.dim { color: var(--t3); }
.faint { color: var(--t4); }
.tiny { font-size: 22rpx; }
.small { font-size: 24rpx; }
.mid { font-size: 26rpx; }
.h1 { font-size: 42rpx; font-weight: 700; line-height: 1.25; }
.h2 { font-size: 34rpx; font-weight: 600; line-height: 1.3; }
.h3 { font-size: 30rpx; font-weight: 600; }
.bold { font-weight: 600; }
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* ---------- 主题色 ---------- */
.c-primary { color: var(--primary); }
.c-gold { color: var(--gold); }
.c-orange { color: var(--orange); }
.c-up { color: var(--up); }
.c-dark { color: var(--dark-card); }

/* ---------- 深色卡片 ---------- */
.dark-card {
  background: linear-gradient(150deg, #323232 0%, #232323 55%, #1C1C1C 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

.dark-card .dim-on-dark {
  color: rgba(255, 255, 255, 0.55);
}

.dark-card .divider-dark {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 24rpx 0;
}

/* ---------- 暖色提示条 ---------- */
.warm-tip {
  display: flex;
  align-items: center;
  background: var(--warm-bg);
  border: 1rpx solid var(--warm-line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--warm-text);
  line-height: 1.45;
}

/* ---------- 按钮 ---------- */
.btn-main {
  background: linear-gradient(135deg, #2FB57E, #1F9D6B);
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(31, 157, 107, 0.28);
}

.btn-main:active { opacity: 0.88; transform: scale(0.99); }

.btn-dark {
  background: #1F1F1F;
  color: #FFFFFF;
  border-radius: 999rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.btn-dark:active { opacity: 0.85; }

.btn-ghost {
  background: #FFFFFF;
  color: var(--t2);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
}

.btn-mini {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--line-2);
  color: var(--t2);
}

.btn-mini-dark {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #1F1F1F;
  color: #FFFFFF;
}

.btn-mini-dark:active { opacity: 0.85; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 500;
}

.tag-green { background: rgba(31, 157, 107, 0.1); color: var(--primary); }
.tag-gold { background: rgba(217, 169, 60, 0.16); color: #9C7A1E; }
.tag-blue { background: rgba(59, 130, 196, 0.12); color: var(--blue); }
.tag-orange { background: rgba(224, 137, 44, 0.14); color: var(--orange); }
.tag-gray { background: var(--line-2); color: var(--t3); }

/* ---------- 图标底 ---------- */
.icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  /* emoji 的行高比汉字大，不锁成 1 的话图标会在方块里偏下，跟右边文字对不齐 */
  line-height: 1;
  /* 锁完行高 emoji 的重心偏上，用上内边距把它压回来（内容区居中线随之下移） */
  box-sizing: border-box;
  padding-top: 4rpx;
  flex-shrink: 0;
}

.icon-box-lg {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
  box-sizing: border-box;
  padding-top: 6rpx;
  flex-shrink: 0;
}

.icon-soft-green { background: rgba(31, 157, 107, 0.1); }
.icon-soft-gold { background: rgba(217, 169, 60, 0.14); }
.icon-soft-orange { background: rgba(224, 137, 44, 0.13); }
.icon-soft-gray { background: #F3F5F4; }

/* ---------- 分割与列表 ---------- */
.divider { height: 1rpx; background: var(--line); }
.divider-inset { height: 1rpx; background: var(--line); margin-left: 84rpx; }

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 150rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #232323;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.28);
  z-index: 60;
  transition: background 0.25s ease, transform 0.25s ease;
}

.fab.on { background: #101010; }

.fab:active { transform: scale(0.94); }

/* ---------- 分段控件 ---------- */
.segment {
  display: flex;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(23, 43, 35, 0.05);
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--t2);
  border-radius: 999rpx;
  transition: all 0.2s;
}

.segment-item.on {
  background: #232323;
  color: #FFFFFF;
  font-weight: 500;
}

/* ---------- 占位 / 空态 ---------- */
.empty {
  padding: 90rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-emoji { font-size: 76rpx; opacity: 0.9; }
.empty-title { margin-top: 22rpx; color: var(--t2); font-size: 28rpx; }
.empty-sub { margin-top: 10rpx; color: var(--t3); font-size: 24rpx; }

/* ---------- CSS 箭头 ---------- */
/* 不用 ⌄ ⌃ ↑ ↓ 等字体符号：它们来自符号字体，字重/字号/基线都与中文不一致。
   统一用两条边旋转绘制，颜色跟随 currentColor，尺寸随时可控。 */
.chev {
  width: 13rpx;
  height: 13rpx;
  margin-left: 12rpx;
  /* 旋转后视觉重心偏下约 3rpx，用负外边距抵消（align-items:center 会分摊 margin） */
  margin-top: -6rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.chev.up {
  margin-top: 6rpx;
  transform: rotate(-135deg);
}

/* ---------- 安全区 ---------- */
.safe-bottom { height: env(safe-area-inset-bottom); }

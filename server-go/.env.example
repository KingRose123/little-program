# 复制成 .env 后按实际情况填写。.env 不要提交到仓库。

# ---------- 服务 ----------
APP_PORT=8080

# 业务时区。整套会员到期逻辑按这个时区的自然日比较，别改成 UTC，
# 否则「今天到期」会比用户的认知早 8 小时。
TZ=Asia/Shanghai

# 构建标记。每次发布改一下（日期或序号都行），
# 排查「我明明改了代码怎么没生效」时，先 curl /api/health 看这个值。
BUILD=2026-09-19-go-initial

# 登录凭证有效期（天）。与旧版一致是 30。
TOKEN_TTL_DAYS=30

# 单份快照上限（字节）。默认 5MB，
# 改小要谨慎：超限对用户的表现只是「一直保存失败一直重试」，属于隐蔽的数据丢失。
MAX_PAYLOAD_BYTES=5242880

# 公开接口（行情）按客户端 IP 的限流：每分钟请求数。设为 0 关闭。
#
# 它保护的是**可用性**：行情接口不校验登录，背后是东财的免费接口
# （按我们的出口 IP 限流）。被刷的结果不是「刷的人慢」，而是
# 所有用户一起拿不到行情。
#
# 为什么不设更小：家用宽带和公司网络后面常常是**一整栋楼共用一个出口 IP**，
# 十个人同时用就是十倍请求量。卡太死会误伤，而误伤的表现是
# 「行情时好时坏」，比被刷还难查。
# 判断该调大还是调小的依据：看日志里有没有 `[limit] 公开接口限流命中`。
PUBLIC_RATE_LIMIT=120

# 后台接口与定时任务的令牌。
# 必须设置，且只用字母、数字、下划线、短横线（它会被拼进 URL 与命令行）。
# 生成一个：openssl rand -hex 24
CRON_TOKEN=换成一串随机字符串

# ---------- 数据库 ----------
# 两种给法，任选其一。
#
# 给法一（推荐，自建 MySQL 常用）：直接给一条 DSN。
# MYSQL_DSN=xiji:你的密码@tcp(127.0.0.1:3306)/xiji?charset=utf8mb4&parseTime=false&loc=Local
#
# 给法二：分开给（沿用旧版云托管的变量名，迁过来少改东西）。
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_USERNAME=xiji
MYSQL_PASSWORD=改成你的密码
MYSQL_DATABASE=xiji

# docker compose 起 MySQL 时要用（不用 compose 建库的话可以删掉）
MYSQL_ROOT_PASSWORD=改成你自己的root密码

# ---------- 兑换码：卖给用户时告诉他们去哪买 ----------
#
# 这几项由服务端下发给 App（GET /api/membership/pay/channels 的 guide 字段），
# 所以改文案只需要改这里 + 重启，**不用发版等审核**。
#
# STEPS 用 `|` 分隔多条，一条一行。三项都可以留空 ——
# 全空时 App 会退化成一句通用的「请联系我们获取」，不会显示一片空白。
REDEEM_GUIDE_TITLE=如何获取兑换码
REDEEM_GUIDE_STEPS=在淘宝搜索「收息佬会员」下单|拍下后把订单号发给客服|客服会把兑换码发给你，在 App「我的 → 收息佬会员」里兑换
REDEEM_GUIDE_CONTACT=客服微信：换成你的微信号

# ---------- 微信支付（App 支付 APIv3）----------
# 现在**留空即可**：留空时下单接口会回 notReady，
# 客户端会引导用户走兑换码开通，功能是通的。
# 等商户号办下来再填这几项，并配合补上 internal/wxpay 的签名实现。
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_API_V3_KEY=
WXPAY_NOTIFY_URL=
# 私钥两种给法选一：PEM 全文（\n 写成字面量也行，程序会还原），或一个文件路径
WXPAY_PRIVATE_KEY=
WXPAY_PRIVATE_KEY_PATH=

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F2F1;
  padding-top: 12rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  --c: #9CA3AF;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 92rpx;
}

.tab-item.on {
  --c: #1F9D6B;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--c);
}

.ico-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 34rpx;
}
.ico-bars .bar {
  width: 7rpx;
  border-radius: 4rpx;
  background: var(--c);
  margin: 0 3rpx;
}
.ico-bars .b1 { height: 15rpx; }
.ico-bars .b2 { height: 34rpx; }
.ico-bars .b3 { height: 24rpx; }

.ico-cal {
  position: relative;
  width: 34rpx;
  height: 32rpx;
  border: 2.5rpx solid var(--c);
  border-radius: 8rpx;
}
.ico-cal .cal-head {
  position: absolute;
  left: 1rpx;
  right: 1rpx;
  top: 8rpx;
  height: 2.5rpx;
  background: var(--c);
}
.ico-cal .cal-leg {
  position: absolute;
  top: -6rpx;
  width: 2.5rpx;
  height: 7rpx;
  border-radius: 2rpx;
  background: var(--c);
}
.ico-cal .cal-leg.l { left: 7rpx; }
.ico-cal .cal-leg.r { right: 7rpx; }
.ico-compass {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 2.5rpx solid var(--c);
  border-radius: 50%;
}
.ico-compass .needle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 15rpx;
  height: 2.5rpx;
  background: var(--c);
  border-radius: 2rpx;
  transform: translate(-50%, -50%) rotate(-45deg);
}
.ico-user {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}
.ico-user .head {
  position: absolute;
  left: 50%;
  top: 1rpx;
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  border: 2.5rpx solid var(--c);
  border-radius: 50%;
}
.ico-user .body {
  position: absolute;
  left: 50%;
  bottom: 1rpx;
  width: 26rpx;
  height: 13rpx;
  margin-left: -13rpx;
  border: 2.5rpx solid var(--c);
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
}

